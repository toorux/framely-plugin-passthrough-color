{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "tooru.passthrough-color",
  "name": "透视调色",
  "version": "0.1.4-preview.10",
  "author": "tooru",
  "homepage": "https://github.com/toorux/framely-plugin-passthrough-color",
  "description": "切换透视模式，调整彩色透视亮度、饱和度与冷暖，以及黑白透视染色。",
  "details": "顶部按钮自动识别关闭、彩色与黑白透视。两套调色参数独立保存，保留黑白预设与色轮图标。新版彩色原生模块需在下次 SteamVR 启动后加载，不会自动重启。",
  "tags": [
    "透视",
    "色调",
    "黑白"
  ],
  "changelog": "移除 SteamVR 整机哈希白名单和固定方法地址，按相机接口、上传布局与 shader 结构分别检测。兼容无关更新、代码地址移动及 shader ID 重编号；检测失败只停用对应功能，保留模式切换与黑白色相的独立可用性。",
  "icon": "icon.png",
  "backend": {
    "entry": "backend.py",
    "runAs": "steamos",
    "autostart": true,
    "restart": "on-failure",
    "restartLimit": 3
  },
  "ui": {
    "quickPage": "page.js"
  },
  "files": {},
  "lifecycle": {
    "onStart": true,
    "onStop": true,
    "timeoutSeconds": 10,
    "onCrashCleanup": {
      "entry": "backend.py",
      "args": [
        "--crash-cleanup"
      ]
    },
    "onUninstall": {
      "entry": "backend.py",
      "args": [
        "--crash-cleanup"
      ]
    }
  }
}
