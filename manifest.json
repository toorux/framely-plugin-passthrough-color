{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "tooru.passthrough-color",
  "name": "透视调色",
  "version": "0.1.4-preview.6",
  "author": "tooru",
  "homepage": "https://github.com/toorux/framely-plugin-passthrough-color",
  "description": "调整 Steam Frame 黑白透视的色调、染色饱和度与亮度。",
  "details": "提供实时色调、饱和度与亮度滑块，中性黑白及冷暖色预设，自动保存和一键恢复。使用 Steam 会话用户权限；首次启用原生调色模块需在下次 SteamVR 启动后生效。不会自动重启 SteamVR。",
  "tags": [
    "透视",
    "色调",
    "黑白"
  ],
  "changelog": "恢复原来的色轮 Logo；三个调节控件改为长方形渐变条，色相显示彩虹，饱和度和亮度渐变跟随当前参数，保留键盘与触控操作。",
  "icon": "icon.png",
  "backend": {
    "entry": "backend.py",
    "runAs": "steamos",
    "autostart": true,
    "restart": "on-failure",
    "restartLimit": 3
  },
  "ui": {
    "quickPage": "page.js"
  },
  "files": {},
  "lifecycle": {
    "onStart": true,
    "onStop": true,
    "timeoutSeconds": 10,
    "onCrashCleanup": {
      "entry": "backend.py",
      "args": [
        "--crash-cleanup"
      ]
    },
    "onUninstall": {
      "entry": "backend.py",
      "args": [
        "--crash-cleanup"
      ]
    }
  },
  "exclusiveResources": [
    "steamvr.passthrough-color"
  ],
  "conflicts": {
    "framely.passthrough-color": "*"
  }
}
