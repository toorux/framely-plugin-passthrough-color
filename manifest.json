{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "tooru.passthrough-color",
  "name": "透视调色",
  "version": "0.1.4-preview.9",
  "author": "tooru",
  "homepage": "https://github.com/toorux/framely-plugin-passthrough-color",
  "description": "切换透视模式，调整彩色透视亮度、饱和度与冷暖，以及黑白透视染色。",
  "details": "顶部按钮自动识别关闭、彩色与黑白透视。两套调色参数独立保存，保留黑白预设与色轮图标。新版彩色原生模块需在下次 SteamVR 启动后加载，不会自动重启。",
  "tags": [
    "透视",
    "色调",
    "黑白"
  ],
  "changelog": "新增关闭透视、彩色透视、黑白透视按钮组及系统模式同步；新增彩色亮度、逐像素饱和度和冷暖长条，独立保存两套参数，保留原黑白调色与色轮图标。彩色 GPU 效果待新版模块首次加载验证。",
  "icon": "icon.png",
  "backend": {
    "entry": "backend.py",
    "runAs": "steamos",
    "autostart": true,
    "restart": "on-failure",
    "restartLimit": 3
  },
  "ui": {
    "quickPage": "page.js"
  },
  "files": {},
  "lifecycle": {
    "onStart": true,
    "onStop": true,
    "timeoutSeconds": 10,
    "onCrashCleanup": {
      "entry": "backend.py",
      "args": [
        "--crash-cleanup"
      ]
    },
    "onUninstall": {
      "entry": "backend.py",
      "args": [
        "--crash-cleanup"
      ]
    }
  }
}
